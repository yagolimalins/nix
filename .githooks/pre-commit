#!/usr/bin/env bash
#
# .githooks/pre-commit — format staged .nix files via the flake's formatter
#
# Uses `nix fmt`, which runs treefmt wrapping nixfmt (see flake.nix).
# Enabled by ./install.sh (or once per clone with):
#   git config core.hooksPath .githooks
#
set -euo pipefail

# Only act when there are staged Nix files — otherwise skip the flake eval.
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- '*.nix')
[[ ${#files[@]} -eq 0 ]] && exit 0

# `nix fmt` passes args after `--` to the formatter (treefmt).
nix fmt -- "${files[@]}"
git add -- "${files[@]}"
